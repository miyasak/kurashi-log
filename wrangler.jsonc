{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tadoreru",
	"compatibility_date": "2026-07-30",
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tadoreru",
			"database_id": "6de3e843-fbac-4574-9d3a-f57fe835637a"
		}
	],
	// 画像アップロード用のオブジェクトストレージ（管理画面から直接アップロード）
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "tadoreru-media"
		}
	]
}